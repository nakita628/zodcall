{
  "name": "zodcall",
  "version": "0.1.1",
  "description": "Type-safe, fetch-based API client with zod validation and autocompletion",
  "keywords": [
    "api",
    "client",
    "fetch",
    "typescript",
    "validation",
    "zod"
  ],
  "homepage": "https://github.com/nakita628/zodcall/tree/main/packages/zodcall#readme",
  "bugs": {
    "url": "https://github.com/nakita628/zodcall/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nakita628/zodcall.git",
    "directory": "packages/zodcall"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "fix": "vp check --fix",
    "test": "vp test run --typecheck",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  }
}
