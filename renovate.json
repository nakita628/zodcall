{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":separateMultipleMajorReleases",
    "security:openssf-scorecard"
  ],
  "timezone": "Asia/Tokyo",
  "schedule": ["* * * * 6"],
  "dependencyDashboardAutoclose": true,
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "minimumReleaseAge": "1 day"
  },
  "platformAutomerge": false,
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "schedule": ["* * * * 6"]
  },
  "packageRules": [
    {
      "matchDatasources": ["github-tags", "github-releases"],
      "minimumReleaseAge": "7 days"
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    },
    {
      "description": "Vite+ ships its own Vite and Vitest: move them together.",
      "matchPackageNames": ["vite-plus", "@voidzero-dev/vite-plus-core", "vitest"],
      "groupName": "Vite+"
    },
    {
      "description": "effect and @effect/platform-node are released together and pinned to the same version.",
      "matchPackageNames": ["effect", "@effect/*"],
      "groupName": "Effect"
    },
    {
      "description": "The TypeSpec compiler and emitter are released together.",
      "matchPackageNames": ["@typespec/*"],
      "groupName": "TypeSpec"
    },
    {
      "matchUpdateTypes": ["pin", "pinDigest"],
      "automerge": true
    },
    {
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "matchCurrentVersion": "!/^0/",
      "automerge": true
    },
    {
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["digest"],
      "automerge": false
    }
  ]
}
